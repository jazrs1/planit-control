# Rendered by deploy/setup.sh to /etc/caddy/Caddyfile, with API_DOMAIN replaced by the api domain.
# Caddy gets and renews the HTTPS certificate itself once DNS points here (ports 80 and 443 open).
API_DOMAIN {
	encode zstd gzip

	# Photo uploads are capped at 10 MB by the API; reject anything much bigger here.
	request_body {
		max_size 12MB
	}

	# During an API restart (deploys) the upstream refuses connections for 1-2 s. Retry the connection
	# for up to 10 s instead of answering 502 at once. Only failed connections are retried, so a request
	# that reached the API is never sent twice.
	reverse_proxy 127.0.0.1:8000 {
		lb_try_duration 10s
		lb_try_interval 250ms
	}

	log {
		output file /var/log/caddy/planit-api.log {
			roll_size 20MiB
			roll_keep 5
		}
	}
}
