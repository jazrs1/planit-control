# Rendered by deploy/setup.sh to /etc/caddy/Caddyfile, with API_DOMAIN replaced by the api domain.
# Caddy gets and renews the HTTPS certificate itself once DNS points here (ports 80 and 443 open).
API_DOMAIN {
	encode zstd gzip

	# Photo uploads are capped at 10 MB by the API; reject anything much bigger here.
	request_body {
		max_size 12MB
	}

	reverse_proxy 127.0.0.1:8000

	log {
		output file /var/log/caddy/planit-api.log {
			roll_size 20MiB
			roll_keep 5
		}
	}
}
