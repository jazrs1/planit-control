# Copy to backend/.env and fill in. Never commit .env.

# Tiger Data (Timescale Postgres) connection string
DATABASE_URL=postgresql://user:password@host:5432/tsdb?sslmode=require

# Google Gemini writes the 6 PM briefings (template fallback without a key)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# NASA FIRMS map key for wildfire detections (https://firms.modaps.eosdis.nasa.gov/api/map_key/)
FIRMS_MAP_KEY=

# Auth0
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_AUDIENCE=https://api.planit-control.dev
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=

# Comma-separated origins allowed by CORS
CORS_ORIGINS=http://localhost:3000

# GOES-19 GLM lightning ingestion: poll NOAA every LIGHTNING_POLL_SECONDS (needs DATABASE_URL)
LIGHTNING_INGEST_ENABLED=true
LIGHTNING_POLL_SECONDS=20

# Weather, NWS alerts, FEMA flood zones, FIRMS fires, iNaturalist wildlife (needs DATABASE_URL)
HAZARD_POLLING_ENABLED=true
# Contact (URL or email) sent in the User-Agent; NWS requires one
NWS_CONTACT=https://github.com/jazrs1/planit-control

# Server-side cache for GET /sites, /sites/{id}, /alerts in seconds (0 disables); alert changes clear it
API_CACHE_SECONDS=2.5

# Evening briefings for tomorrow, at this hour in each site's timezone
BRIEFING_ENABLED=true
BRIEFING_HOUR=18
